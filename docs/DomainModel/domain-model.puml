FlightRoute "1" --> "1" AirTransportCompany : belongs to >
Flight "0..*" --> "1" FlightRoute : belongs to
AircraftModel "1" --> "1..*" EngineModel : certifies >
AirTransportCompany "1" ..> User : has collaborators >
AirControlArea "1" ..> User : has collaborators >
SimulationReport "0..*" --> "1" Flight : validates >
Report "1..*" --> "1" AirControlArea : scoped to >
Report "1..*" --> "1..*" SimulationReport : based on >
Report "1..*" --> "1..*" Flight : aggregates >
AircraftModel "1..*" --> "1" Maker : makerId >
EngineModel "1..*" --> "1" Maker : makerId >
EngineModel "1..*" --> "1" FuelType : fuelTypeName >
