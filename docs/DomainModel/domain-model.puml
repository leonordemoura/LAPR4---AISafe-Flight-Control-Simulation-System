@startuml
skinparam packageStyle rectangle
skinparam shadowing true
skinparam classAttributeIconSize 0
hide methods

package "User Aggregate" {

    class User <<entity>> <<aggregateRoot>> {
    }

    class SystemUser <<framework entity>> {
    }

    class Role <<framework vo>> {
        roleName
    }

    class AisafeRoles <<utility>> {
        {static} ADMIN : Role
        {static} BACKOFFICE_OPERATOR : Role
        {static} AIR_TRANSPORT_COMPANY_COLLABORATOR : Role
        {static} PILOT : Role
        {static} FLIGHT_CONTROL_OPERATOR : Role
        {static} WEATHER_PERSON : Role
    }

    class AisafeProfile <<entity>> {
    }

    class SecurityClearance <<vo>> {
        expiryDate
    }

    class SkillsAssessment <<vo>> {
        lastAssessmentDate
    }

    class Email <<vo>> {
        emailAddress
    }

    class Email_Domains <<vo>> {
        domain
    }

    class PhoneNumber <<vo>> {
        code {*country code*}
        number
    }

    class FullName <<vo>> {
        firstName
        lastName
    }

    ' ── DOMAIN USER ─────────────────────────────
    User "1" *-- "1" Email : identifies >
    User "1" *-- "1" FullName : has >
    User "1" *-- "1" PhoneNumber : has >
    User "1" *-- "0..1" AisafeProfile : has >

    AisafeProfile "1" *-- "1" SecurityClearance
    AisafeProfile "1" *-- "1" SkillsAssessment

    Email "1" *-- "1" Email_Domains : belongs to >

    ' ── AUTH SYSTEM USER ───────────────────────
    SystemUser "1" --> "*" Role : assigned >
    SystemUser "1" --> "1" Email : username/email >

    ' ── LINK (CONCEPTUAL ONLY) ─────────────────
    User ..> SystemUser : linked by email/username

    AisafeRoles ..> Role

}

package "WeatherData Aggregate" {

    class WeatherData <<entity>> <<root>> {
    }

    class AreaCode <<vo>> {
        value
    }

    class ObservationDate <<vo>> {
        startDateTime
        endDateTime
    }

    class WeatherSource <<vo>> {
        value
    }

    class WindDirection <<vo>> {
        degrees
    }

    class WindSpeed <<vo>> {
        value
    }

    class Temperature <<vo>> {
        value
    }

    class Pressure <<vo>> {
        value
    }

    class WeatherSubArea <<vo>> {
        minLatitude
        maxLatitude
        minLongitude
        maxLongitude
        minAltitude
        maxAltitude
    }

    enum WindSpeedUnit {
        MPS
        KMH
        KT
    }

    enum TemperatureUnit {
        C
        F
    }

    enum PressureUnit {
        HPA
        PA
    }

    WeatherData "1" *-- "1" AreaCode : belongs to
    WeatherData "1" *-- "1" ObservationDate
    WeatherData "1" *-- "1" WeatherSource
    WeatherData "1" *-- "1" WeatherSubArea : applies to >
    WeatherData "1" *-- "1" WindDirection
    WeatherData "1" *-- "1" WindSpeed
    WeatherData "1" *-- "1" Temperature
    WeatherData "1" *-- "1" Pressure
    WindSpeed "1" --> "1" WindSpeedUnit : has unit >
    Temperature "1" --> "1" TemperatureUnit : has unit >
    Pressure "1" --> "1" PressureUnit : has unit >
}

