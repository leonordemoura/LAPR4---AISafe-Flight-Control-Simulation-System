@startuml
'https://plantuml.com/class-diagram
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing true

package "backoffice" {

    package "app" {
        package "console" {

            class ImportBulkWeatherDataUI <<presentation>> {
                - controller : ImportBulkWeatherDataController
                + doShow() : boolean
            }

        }
    }
}

package "core" {

    class ImportBulkWeatherDataController <<controller>> {
        - service : ImportBulkWeatherDataService
        + importBulkWeatherData(source : WeatherImportSource, input : String) : ImportResult
    }

    class ImportBulkWeatherDataService <<service>> {
        - weatherDataRepository : WeatherDataRepository
        - weatherSourceRepository : WeatherSourceRepository
        - airControlAreaRepository : AirControlAreaRepository

        + importBulkWeatherData(source : WeatherImportSource, input : String) : ImportResult
    }

    class ImportResult <<dto>> {
        + success : boolean
        + importedCount : int
        + failedCount : int
    }

    enum WeatherImportSource {
        CSV
        EXTERNAL_API
        OTHER
    }

    interface WeatherDataRepository <<repository>> {
        + save(data : WeatherData) : void
    }

    interface WeatherSourceRepository <<repository>> {
        + saveSourceLog(source : WeatherImportSource) : void
    }

    interface AirControlAreaRepository <<repository>> {
        + findByAreaCode(code : String) : AirControlArea
    }

    class WeatherData <<entity>> <<aggregateRoot>> {
        - observationDate : ObservationDate
        - areaCode : AreaCode
        - weatherSource : WeatherSource
        - windDirection : WindDirection
        - windSpeed : WindSpeed
        - temperature : Temperature
        - pressure : Pressure
    }

    class WeatherSource <<vo>> {
        value
    }

    class ObservationDate <<vo>>
    class AreaCode <<vo>>

    class WindDirection <<vo>>
    class WindSpeed <<vo>>
    class Temperature <<vo>>
    class Pressure <<vo>>

    class AirControlArea <<entity>> <<aggregateRoot>>

    ' ── Domain relationships ──────────────────────────
    WeatherData "1" *-- "1" ObservationDate
    WeatherData "1" *-- "1" AreaCode
    WeatherData "1" *-- "1" WeatherSource
    WeatherData "1" *-- "1" WindDirection
    WeatherData "1" *-- "1" WindSpeed
    WeatherData "1" *-- "1" Temperature
    WeatherData "1" *-- "1" Pressure

    AirControlArea "1" <-- "0..*" WeatherData : aggregates >

    ' ── Repository relationships ──────────────────────
    WeatherDataRepository ..> WeatherData : persists >
    WeatherSourceRepository ..> WeatherImportSource : logs >
    AirControlAreaRepository ..> AirControlArea

    ' ── Architecture relationships ────────────────────
    ImportBulkWeatherDataUI ..> ImportBulkWeatherDataController : uses >
    ImportBulkWeatherDataController ..> ImportBulkWeatherDataService : uses >
    ImportBulkWeatherDataController ..> ImportResult : returns >

    ImportBulkWeatherDataService ..> WeatherDataRepository : uses >
    ImportBulkWeatherDataService ..> WeatherSourceRepository : uses >
    ImportBulkWeatherDataService ..> AirControlAreaRepository : uses >

    ImportBulkWeatherDataService ..> WeatherData : creates >
    ImportBulkWeatherDataService ..> WeatherImportSource : validates >

}

@enduml