@startuml
'https://plantuml.com/class-diagram

package "backoffice" {
    package "app"{
        package "console" {
            class RegisterAirTransportCompanyUI <<presentation>>{
            - controller: RegisterAirTransportCompanyController
            + doShow(): boolean
            }
        }
    }
}

package "core"{
    class RegisterAirTransportCompanyController <<controller>>{
        - factory : RepositoryFactory
        + registerAirTransportCompany() : boolean
    }

    class AirTransportCompany <<entity>> <<aggregateRoot>>

    class AirTransportCompanyName <<vo>>{
        - name: String
    }

    class IataCode <<vo>>{
        - value: String
    }

    class IacoCode <<vo>>{
        - value: String
    }

    interface AirTransportCompanyRepository <<repository>>

    ' ── Domain relationships (from aggregate) ──────────────────────────
    AirTransportCompany "1" *-- "1" AirTransportCompanyName                 : named >
    AirTransportCompany "1" *-- "1" IataCode                                : code >
    AirTransportCompany "1" *-- "1" IacoCode                                : code >

    ' ── Repository manages the aggregate ───────────────────────────────
    AirTransportCompanyRepository ..> AirTransportCompany            : persists >

    ' ── Architecture / layered relationships (from sequence diagram) ───
    RegisterAirTransportCompanyUI ..> RegisterAirTransportCompanyController  : uses >
    RegisterAirTransportCompanyController ..> AirTransportCompany            : creates >
    RegisterAirTransportCompanyController ..> AirTransportCompanyRepository  : uses >

}

@enduml