@startuml
skinparam packageStyle rectangle
skinparam shadowing true
skinparam classAttributeIconSize 0
hide methods

package "FlightRoute Aggregate" <<Rectangle>> {

    class FlightRoute <<entity>> <<root>>


    class DeactivationDate <<vo>> {
        value
    }

    class RouteName <<vo>> {
        companyIata
        ' exactly 2 letters
        number
        ' 1 to 4 digits (e.g. TP123)
    }

    class RouteDesignator <<vo>> {
        origin
        destination
    }

    ' Relacionamentos FlightRoute
    DeactivationDate "1" --* "1" FlightRoute : has <
    FlightRoute "1" *-- "1" RouteName : identified by >
    FlightRoute "1" *-- "1" RouteDesignator : has >
}

package "Flight Aggregate" {
    class Flight <<entity>> <<aggregateRoot>> {
    }

    class FlightDesignator <<vo>> {
        airlineCode
        flightNumber
        operationalSuffix
    }

    class FlightPlan <<entity>> {
        submittedAt
        rejectionReason
    }

    class FuelQuantity <<vo>> {
        value
        unit
    }

    class DepartureDatetime <<vo>> {
        dateTime
    }

    class AircraftRegistration <<vo>> {
        value
    }

    class PilotEmail <<vo>> {
        value
    }

    enum FlightType <<enum>> {
        REGULAR
        CHARTER
    }

    enum FlightPlanStatus <<enum>> {
        DRAFT
        VALIDATED
        ACTIVE
        CANCELLED
    }

    Flight "1" *-- "1" FlightDesignator : identified by >
    Flight "1" --> "1" FlightType : typed as >
    FlightPlan "1" --> "1" AircraftRegistration : uses >
    FlightPlan "1" --> "1" PilotEmail : assigned to >
    FlightPlan "1" *-- "1" DepartureDatetime
    FlightPlan "1" --> "1" FlightPlanStatus : current status >
    Flight "1" *-- "0..*" FlightPlan : has plans >

    FlightPlan "1" *-- "1" FuelQuantity
}

Flight "0..*" --> "1" FlightRoute : belongs to

@enduml