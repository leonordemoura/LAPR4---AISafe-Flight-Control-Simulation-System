@startuml
skinparam packageStyle rectangle
skinparam shadowing true
skinparam classAttributeIconSize 0
hide methods


package "Aircraft Aggregate"{
    class Aircraft <<entity>> <<root>> {
    }

    class AircraftRegistration <<vo>> {
        value
    }

    class CompanyId <<vo>> {
        value
    }

    class FlightCrewSize <<vo>> {
        value
    }

    class Country <<vo>> {
        code
        name
    }

    class CabinConfiguration <<vo>> {
        firstClassSeats
        businessSeats
        economySeats
    }

    enum AircraftStatus <<enum>> {
        ACTIVE
        DECOMMISSIONED
    }

    ' Relacionamentos Aircraft
    Aircraft "1" *-- "1" AircraftRegistration
    Aircraft "1" *-- "1" CompanyId : belongs to
    Aircraft "1" *-- "1" FlightCrewSize
    Aircraft "1" *-- "1" Country : registered in >
    Aircraft "1" *-- "1" CabinConfiguration
    Aircraft "1" --> "1" AircraftStatus : has >

}

package "AirTransportCompany Aggregate" {
    class AirTransportCompany <<entity>> <<root>> {
    }

    class CompanyId <<vo>> {
        value
    }

    class CompanyName <<vo>> {
        value
    }

    class IataCode <<vo>> {
        value
    }

    class IcaoCode <<vo>> {
        value
    }

    class CompanyMembership <<vo>> {
        'ligação com User
        userID
        validUntil
    }

    enum MemberType <<enum>> {
        ATCC
        PILOT
    }

    class UserId <<vo>> {
        value
    }

    ' Relacionamentos AirTransportCompany
    AirTransportCompany "1" *-- "1" CompanyId
    AirTransportCompany "1" *-- "1" CompanyName
    AirTransportCompany "1" *-- "1" IataCode
    AirTransportCompany "1" *-- "1" IcaoCode
    AirTransportCompany "1" *-- "0..*" CompanyMembership : has >
    CompanyMembership "1" *-- "1" MemberType : typed as >
    CompanyMembership "1" *-- "1" UserId : ref userID
}

' Relacionamentos
Aircraft "0..*" --> "1" AirTransportCompany : belongs to


@enduml