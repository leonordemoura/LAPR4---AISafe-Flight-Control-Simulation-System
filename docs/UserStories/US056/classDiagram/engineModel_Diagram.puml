@startuml
'https://plantuml.com/class-diagram

package "backoffice" {
    package "app"{
        package "console" {
            class RegisterEngineModelUI <<presentation>>{
            - controller: EngineModelController
            + doShow(): boolean
            }
        }
    }
}

package "core"{
    class RegisterEngineModelController <<controller>>{
        - factory : RepositoryFactory
        + registerEngineModel() : boolean
    }

    class EngineModel <<entity>> <<aggregateRoot>>

    class EngineModelName <<vo>>{
        - name: String
    }

    class Power <<vo>>{
        - value: Integer
        - unit : Unit
    }

    class TSFC <<vo>>{
        - value: Double
    }

    class FuelType <<entity>>

    class FuelTypeName <<vo>>{
        - type: String
    }

     class FuelTypeDensity <<vo>>{
        - density: Double
    }

     class FuelTypeSpecificEnergy <<vo>>{
        - specificEnergy: Double
    }

    enum MotorizationType <<enum>>{
        TURBOPROP
        TURBOFAN
        TURBOJET
        RAMJET
        ELECTRIC_PROPELLER
    }

    class Maker <<entity>>

    class MakerName <<vo>>{
        - name: String
    }

    class MakerId <<vo>>{
        - id: Long
    }

    class Country <<vo>>{
        - name: String
        - numericCode: Integer
    }

    enum Unit <<enum>>{
            HORSEPOWER
            KILOWATT
    }

    interface EngineModelRepository <<repository>>

    interface MakerRepository <<repository>>

    interface FuelTypeRepository <<repository>>

    ' ── Domain relationships (from aggregate) ──────────────────────────
    EngineModel "1" *-- "1" EngineModelName         : named >
    EngineModel "1" *-- "1" Power                   : power >
    EngineModel "1" *-- "1" TSFC                    : tsfc >
    EngineModel "1" *-- "1" FuelType                : fuelType >
    EngineModel "1" --> "1" MotorizationType         : typed as >
    EngineModel "1..*" --> "1" Maker                : made by >
    Power "1" --> "1" Unit                         : measured in >

    ' ── Repository manages the aggregate ───────────────────────────────
    EngineModelRepository ..> EngineModel               : persists >
    MakerRepository ..> Maker                           : persists >
    FuelTypeRepository ..> FuelType                     : persists >

    ' ── Architecture / layered relationships (from sequence diagram) ───
    RegisterEngineModelUI ..> RegisterEngineModelController  : uses >
    RegisterEngineModelController ..> EngineModel            : creates >
    RegisterEngineModelController ..> EngineModelRepository  : uses >
    RegisterEngineModelController ..> MakerRepository        : uses >
    RegisterEngineModelController ..> FuelTypeRepository     : uses >

    ' ── Relationships with maker ───────────────
    Maker "1" *-- "1" MakerId          : identified by >
    Maker "1" *-- "1" MakerName          : identified by >
    Maker "1" *-- "1" Country          : located in >

    FuelType "1" *-- "1" FuelTypeName          : identified by >
    FuelType "1" *-- "1" FuelTypeDensity          : has density >
    FuelType "1" *-- "1" FuelTypeSpecificEnergy          : has specific energy >
}

@enduml